    { "lemma": "good afternoon", "pos": "phrase", "tr": "iyi günler (öğleden sonra)", "ipa": "/ɡʊd ˌɑːftəˈnuːn/", "ex_en": "Good afternoon! How are you?", "ex_tr": "İyi günler! Nasılsınız?" },
    { "lemma": "good evening", "pos": "phrase", "tr": "iyi akşamlar (selam)", "ipa": "/ɡʊd ˈiːvnɪŋ/", "ex_en": "Good evening, Ms Smith.", "ex_tr": "İyi akşamlar, Bayan Smith." },
    { "lemma": "good night", "pos": "phrase", "tr": "iyi geceler", "ipa": "/ɡʊd ˈnaɪt/", "ex_en": "Good night! See you.", "ex_tr": "İyi geceler! Görüşürüz." },
    { "lemma": "goodbye", "pos": "interj", "tr": "hoşça kal, güle güle", "ipa": "/ɡʊdˈbaɪ/", "ex_en": "Goodbye, Mr Brown.", "ex_tr": "Hoşça kalın, Bay Brown." },
    { "lemma": "bye", "pos": "interj", "tr": "bay bay, hoşça kal", "ipa": "/baɪ/", "ex_en": "Bye, Tom!", "ex_tr": "Hoşça kal, Tom!" },
    { "lemma": "see you", "pos": "phrase", "tr": "görüşürüz", "ipa": "/ˈsiː juː/", "ex_en": "Bye! See you later.", "ex_tr": "Hoşça kal! Sonra görüşürüz." },
    { "lemma": "how are you", "pos": "phrase", "tr": "nasılsın", "ipa": "/ˌhaʊ ˈɑː juː/", "ex_en": "Hi, Emma! How are you?", "ex_tr": "Selam, Emma! Nasılsın?" },
    { "lemma": "fine", "pos": "adj", "tr": "iyi", "ipa": "/faɪn/", "ex_en": "I'm fine, thank you.", "ex_tr": "İyiyim, teşekkür ederim." },
    { "lemma": "thank you", "pos": "phrase", "tr": "teşekkür ederim", "ipa": "/ˈθæŋk juː/", "ex_en": "Thank you very much.", "ex_tr": "Çok teşekkür ederim." },
    { "lemma": "thanks", "pos": "interj", "tr": "sağ ol, teşekkürler", "ipa": "/θæŋks/", "ex_en": "I'm OK, thanks.", "ex_tr": "İyiyim, sağ ol." },
    { "lemma": "please", "pos": "adv", "tr": "lütfen", "ipa": "/pliːz/", "ex_en": "Spell it, please.", "ex_tr": "Lütfen harf harf söyle." },
    { "lemma": "sorry", "pos": "adj", "tr": "özür dilerim, pardon", "ipa": "/ˈsɒri/", "ex_en": "Sorry! Excuse me.", "ex_tr": "Pardon! Affedersiniz." },
    { "lemma": "excuse me", "pos": "phrase", "tr": "affedersiniz", "ipa": "/ɪkˈskjuːz miː/", "ex_en": "Excuse me, Ms Smith.", "ex_tr": "Affedersiniz, Bayan Smith." },
    { "lemma": "very", "pos": "adv", "tr": "çok", "ipa": "/ˈveri/", "ex_en": "Very well, thank you.", "ex_tr": "Çok iyiyim, teşekkür ederim." }
  ]
