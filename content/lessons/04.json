    { "type": "listen", "audio": "I'm from the USA. I'm American.", "prompt_tr": "Bu kişi nereli?", "options": ["İngiltere", "Almanya", "ABD", "İtalya"], "answer": 2, "explain_tr": "the USA = ABD, American = Amerikalı." },
    { "type": "match", "prompt_tr": "Ülkeyi milliyetle eşleştir.", "pairs": [["France", "French"], ["Italy", "Italian"], ["China", "Chinese"], ["Turkey", "Turkish"]] },
    { "type": "mcq", "prompt": "Nice to meet you.", "prompt_tr": "En uygun cevap hangisi?", "options": ["Good night.", "Nice to meet you, too.", "I'm 20."], "answer": 1, "explain_tr": "Cevap: Nice to meet you, too. (Ben de memnun oldum.)" },
    { "type": "mcq", "prompt": "Hangisi doğru?", "options": ["I'm Turkey.", "I'm from Turkish.", "I'm from turkey.", "I'm Turkish."], "answer": 3, "explain_tr": "Milliyetle from kullanılmaz ve ülkeler büyük harfle yazılır." },
    { "type": "listen", "audio": "Where are you from?", "prompt_tr": "Duyduğun soru ne demek?", "options": ["Adın ne?", "Nerelisin?", "Kaç yaşındasın?"], "answer": 1, "explain_tr": "Where are you from? = Nerelisin?" },
    { "type": "fill", "prompt": "Where ___ you from?", "tr": "Nerelisin?", "options": ["are", "is", "am"], "answer": 0, "explain_tr": "you ile are kullanılır: Where are you from?" }
  ],
