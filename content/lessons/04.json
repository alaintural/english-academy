    { "type": "match", "prompt_tr": "Ülkeyi milliyetle eşleştir.", "pairs": [["Japan", "Japanese"], ["Italy", "Italian"], ["England", "English"], ["the USA", "American"]] },
    { "type": "fill", "prompt": "What's your ___?", "tr": "Adın ne?", "options": ["from", "name", "nice"], "answer": 1, "explain_tr": "What's your name? = Adın ne?" },
    { "type": "fill", "prompt": "I'm ___ Turkey.", "tr": "Türkiye'denim.", "options": ["you", "my", "from"], "answer": 2, "explain_tr": "**from** = -den / -dan." },
    { "type": "order", "answer": "Where are you from?", "tr": "Nerelisin?" },
    { "type": "listen", "audio": "Nice to meet you.", "prompt_tr": "Ne duydun?", "options": ["Tanıştığımıza memnun oldum.", "Nerelisin?", "Adın ne?"], "answer": 0, "explain_tr": "Nice to meet you = Tanıştığımıza memnun oldum." },
    { "type": "fill", "prompt": "I'm from Germany. I'm ___.", "tr": "Almanya'danım. Alman'ım.", "options": ["Germany", "German", "English"], "answer": 1, "explain_tr": "Germany ülke, German milliyet." },
    { "type": "mcq", "prompt": "Where are you from?", "prompt_tr": "Doğru cevabı seç.", "options": ["I'm 20.", "I'm fine.", "I'm from Italy.", "Goodbye."], "answer": 2, "explain_tr": "Where are you from? sorusuna I'm from … ile cevap verilir." },
    { "type": "listen", "audio": "I'm from Japan. I'm Japanese.", "prompt_tr": "Bu kişi nereli?", "options": ["Çin", "İspanya", "Japonya"], "answer": 2, "explain_tr": "Japan = Japonya, Japanese = Japon." },
    { "type": "order", "answer": "Nice to meet you, too.", "tr": "Ben de memnun oldum." }
  ],
  "test": [
    { "type": "fill", "prompt": "My name ___ Elif.", "tr": "Benim adım Elif.", "options": ["are", "is", "am"], "answer": 1, "explain_tr": "Kalıp: My name is …" },
    { "type": "mcq", "prompt": "What's your name?", "prompt_tr": "Doğru cevap hangisi?", "options": ["I'm from France.", "Nice to meet you, too.", "I'm Tom."], "answer": 2, "explain_tr": "Adın sorulunca I'm … ya da My name is … dersin." },
    { "type": "order", "answer": "I'm from Turkey.", "tr": "Türkiye'denim.", "explain_tr": "I'm + from + ülke." },
