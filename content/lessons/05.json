    { "lemma": "orange", "pos": "adj", "tr": "turuncu", "ipa": "/ˈɒrɪndʒ/", "ex_en": "That bag is orange.", "ex_tr": "Şu çanta turuncu." },
    { "lemma": "brown", "pos": "adj", "tr": "kahverengi", "ipa": "/braʊn/", "ex_en": "This book is brown.", "ex_tr": "Bu kitap kahverengi." }
