    },
    {
      "type": "mcq",
      "prompt": "“he's not” = ?",
      "prompt_tr": "Aynı anlamdaki biçimi seç.",
      "options": ["he aren't", "he not", "he isn't"],
      "answer": 2,
      "explain_tr": "he's not ve he isn't ikisi de “he is not” demektir."
    },
    {
      "type": "match",
      "prompt_tr": "Eşleştir.",
      "pairs": [["I'm not tired.", "Yorgun değilim."], ["She isn't here.", "O burada değil."], ["They aren't late.", "Onlar geç kalmadı."], ["It isn't my bag.", "O benim çantam değil."]]
    },
    {
      "type": "listen",
      "audio": "She's not from England.",
      "prompt_tr": "Duyduğun cümleyi seç.",
      "options": ["She's from England.", "She's not from England.", "He's not from England."],
      "answer": 1,
      "explain_tr": "Cümlede not vardı: She's not = O … değil."
    },
    {
