        { "en": "forty-eight", "tr": "48" },
        { "en": "ninety-nine", "tr": "99" }
      ]
    },
    {
      "type": "examples",
      "title_tr": "Yaş sormak ve söylemek",
      "items": [
        { "en": "How old are you?", "tr": "Kaç yaşındasın?", "note_tr": "**old** = yaşlı, eski. Bu soruda “kaç yaşında” anlamına gelir." },
        { "en": "I'm 25.", "tr": "25 yaşındayım." },
        { "en": "I'm 25 years old.", "tr": "25 yaşındayım.", "note_tr": "İkisi de doğru. Ama “I'm 25 years.” yanlış: ya sadece sayı ya da **years old** birlikte." },
        { "en": "I'm thirteen. And you?", "tr": "On üç yaşındayım. Ya sen?" }
      ]
    },
    {
      "type": "examples",
      "title_tr": "Telefon numarası",
      "items": [
        { "en": "What's your phone number?", "tr": "Telefon numaran ne?", "note_tr": "**What's** = What is (… ne?)" },
        { "en": "It's 0 5 3 2, 7 1 4, 2 8 5 6.", "tr": "0532 714 2856.", "note_tr": "Rakamlar tek tek okunur. 0 için **oh** (ou) ya da **zero** denir." },
        { "en": "Double five.", "tr": "55 (iki tane beş)", "note_tr": "Yan yana iki aynı rakam için **double** denir, tıpkı alfabedeki gibi." }
      ]
    }
